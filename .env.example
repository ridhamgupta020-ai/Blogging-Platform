NODE_ENV=development
PORT=3000
# Replace locally with a random value; configure a stable secret in Render's Environment.
SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
# SQLite paths are relative to the project root locally. On Render, use paths under
# a persistent disk mount such as /var/data after attaching a disk.
DATABASE_PATH=./Backend/data/blogging-platform.sqlite
UPLOADS_PATH=./Backend/uploads

SUPABASE_URL=https://tsmkeivqvqnyfcmaqbhb.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
PUBLIC_APP_URL=http://localhost:3000
